{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "outDir": "../../dist/out-tsc",
    "module": "nodenext",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "isolatedModules": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
