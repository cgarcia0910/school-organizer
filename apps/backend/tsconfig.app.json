{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../../",
    "outDir": "../../dist/out-tsc",
    "module": "nodenext",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "moduleResolution": "nodenext",
    "lib": ["es2022"],
    "skipLibCheck": true,
    "isolatedModules": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../libs/backend/generated-server-scenario"
    },
    {
      "path": "../../libs/backend/generated-server-habilitation"
    },
    {
      "path": "../../libs/backend/generated-server-course"
    },
    {
      "path": "../../libs/backend/generated-server-subject"
    },
    {
      "path": "../../libs/backend/generated-server-teacher/tsconfig.lib.json"
    }
  ]
}
