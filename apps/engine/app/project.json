{
    "name": "engine",
    "projectType": "application",
    "targets": {
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "uvicorn app.main:app --reload --port 8000",
          "cwd": "apps/engine"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "ruff app"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pytest"
        }
      }
    },
    "tags": ["type:api", "lang:python"]
  }