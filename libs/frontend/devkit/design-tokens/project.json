{
  "name": "design-tokens",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/frontend/devkit/design-tokens/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/frontend/devkit/design-tokens",
        "main": "libs/frontend/devkit/design-tokens/src/index.ts",
        "tsConfig": "libs/frontend/devkit/design-tokens/tsconfig.lib.json",
        "assets": [
          "libs/frontend/devkit/design-tokens/*.md",
          {
            "input": "libs/frontend/devkit/design-tokens",
            "glob": "**/*.scss",
            "output": "."
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/frontend/devkit/design-tokens/jest.config.ts"
      }
    }
  }
}