{
  "name": "generated-server-course",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/backend/generated-server-course/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/backend/generated-server-course",
        "main": "libs/backend/generated-server-course/src/index.ts",
        "tsConfig": "libs/backend/generated-server-course/tsconfig.lib.json",
        "assets": ["libs/backend/generated-server-course/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/backend/generated-server-course/jest.config.ts"
      }
    }
  }
}
