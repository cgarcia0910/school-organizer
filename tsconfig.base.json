{
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "importHelpers": true,
    "isolatedModules": false,
    "lib": ["es2022", "dom"],
    "moduleResolution": "node",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "paths": {
      "@organizer/plugin": ["tools/be/plugin/src/index.ts"],
      "@organizer/fe": ["tools/fe/src/index.ts"],
      "config/Routes": [
        "apps/frontend/config/config/src/app/remote-entry/entry.routes.ts"
      ],
      "planning/Routes": [
        "apps/frontend/planning/planning/src/app/remote-entry/entry.routes.ts"
      ],
      "@organizer/ui-material": ["apps/frontend/ui/ui-material/src/index.ts"],
      "@organizer/api-config": [
        "libs/frontend/infrastructure/api/api-config/src/index.ts"
      ],
      "@organizer/generated-server-teacher": [
        "libs/backend/generated-server-teacher/src/index.ts"
      ],
      "@school-organizer/teacher-management-feature": [
        "libs/frontend/domain/config/teacher-management-feature/src/index.ts"
      ],
      "@organizer/devkit/forms": ["libs/frontend/devkit/forms/src/index.ts"],
      "@organizer/teacher-api": [
        "libs/frontend/infrastructure/api/teacher-api/src/index.ts"
      ],
      "@organizer/generated-server-subject": [
        "libs/backend/generated-server-subject/src/index.ts"
      ],
      "@organizer/subject-api": [
        "libs/frontend/infrastructure/api/subject-api/src/index.ts"
      ],
      "@organizer/generated-server-course": [
        "libs/backend/generated-server-course/src/index.ts"
      ],
      "@organizer/generated-server-habilitation": [
        "libs/backend/generated-server-habilitation/src/index.ts"
      ],
      "@organizer/course-api": [
        "libs/frontend/infrastructure/api/course-api/src/index.ts"
      ],
      "@organizer/habilitation-api": [
        "libs/frontend/infrastructure/api/habilitation-api/src/index.ts"
      ],
      "@school-organizer/subject-management-feature": [
        "libs/frontend/domain/config/subject-management-feature/src/index.ts"
      ],
      "@school-organizer/course-management-feature": [
        "libs/frontend/domain/config/course-management-feature/src/index.ts"
      ],
      "@organizer/generated-server-scenario": [
        "libs/backend/generated-server-scenario/src/index.ts"
      ],
      "@organizer/scenario-api": [
        "libs/frontend/infrastructure/api/scenario-api/src/index.ts"
      ],
      "@school-organizer/planning/scenario-management-feature": [
        "libs/frontend/domain/planning/scenario-management-feature/src/index.ts"
      ],
      "@school-organizer/planning/scenario-timetable-feature": [
        "libs/frontend/domain/planning/scenario-timetable-feature/src/index.ts"
      ],
      "@school-organizer/planning/scenario-actions": [
        "libs/frontend/domain/planning/scenario-actions/src/index.ts"
      ],
      "@devkit/design-tokens": [
        "libs/frontend/devkit/design-tokens/src/index.ts"
      ]
    }
  }
}
