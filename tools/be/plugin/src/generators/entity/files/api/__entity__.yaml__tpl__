openapi: 3.0.3
info:
  title: My API
  version: 1.0.0

paths:
  /<%= entity %>:
    get:
      tags:
        - <%= entityClassName %>
      summary: Obtener lista paginada de <%= entity %>
      parameters:
        - name: page
          in: query
          required: false
          schema:
            type: integer
            minimum: 1
            default: 1
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            minimum: 1
            maximum: 100
            default: 10
      responses:
        '200':
          description: Lista paginada de <%= entity %>
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Paginated<%= entityClassName %>Response'

    post:
      tags:
        - <%= entityClassName %>
      summary: Crear un teacher
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Create<%= entityClassName %>Dto'
      responses:
        '201':
          description: <%= entityClassName %> creado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/<%= entityClassName %>'

  /<%= entity %>/{id}:
    get:
      tags:
        - <%= entityClassName %>
      summary: Obtener un teacher por id
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '200':
          description: <%= entityClassName %> encontrado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/<%= entityClassName %>'
        '404':
          description: <%= entityClassName %> no encontrado

    put:
      tags:
        - <%= entityClassName %>
      summary: Reemplazar un teacher
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/Update<%= entityClassName %>Dto'
      responses:
        '200':
          description: <%= entityClassName %> actualizado
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/<%= entityClassName %>'

    delete:
      tags:
        - <%= entityClassName %>
      summary: Eliminar un teacher
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: integer
      responses:
        '204':
          description: <%= entityClassName %> eliminado correctamente

components:
  schemas:
    <%= entityClassName %>:
      type: object
      required:
        - id
        - name
      properties:
        id:
          type: integer
          example: 1
        name:
          type: string
          example: Juan Pérez

    Create<%= entityClassName %>Dto:
      type: object
      required:
        - name
      properties:
        name:
          type: string
          example: Juan Pérez

    Update<%= entityClassName %>Dto:
      type: object
      properties:
        name:
          type: string
          example: Juan Pérez

    PaginationMeta:
      type: object
      required:
        - page
        - limit
        - total
      properties:
        page:
          type: integer
          example: 1
        limit:
          type: integer
          example: 10
        total:
          type: integer
          example: 42

    Paginated<%= entityClassName %>Response:
      type: object
      required:
        - data
        - meta
      properties:
        data:
          type: array
          items:
            $ref: '#/components/schemas/<%= entityClassName %>'
        meta:
          $ref: '#/components/schemas/PaginationMeta'
